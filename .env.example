# EcoRoute AI - Environment Variables
# Copy to .env and fill in your values

# ─── AWS Configuration ────────────────────────────────────────────────────────
# NEVER commit actual credentials to git.
# Use IAM roles, Cognito, or environment injection in production.

VITE_AWS_REGION=ap-south-1

# API Gateway endpoint (from your deployed SAM/CDK stack)
VITE_API_GW_URL=https://y7fgmgfaid.execute-api.ap-south-1.amazonaws.com/prod


# S3 bucket name
VITE_S3_BUCKET=ecoroute-ai-data-522688056711


# DynamoDB table names
VITE_DYNAMODB_USER_TABLE=EcoRoute-UserPreferences
VITE_DYNAMODB_ROUTES_TABLE=EcoRoute-SavedRoutes

# Demo user ID for local development
VITE_DEMO_USER_ID=demo-user-001

# ─── Optional: External APIs ──────────────────────────────────────────────────
# OpenAQ (free tier available)
VITE_OPENAQ_API_KEY=

# CPCB or government environmental data endpoint
VITE_CPCB_API_URL=

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to 'true' to force demo mode regardless of API availability
VITE_FORCE_DEMO_MODE=false
